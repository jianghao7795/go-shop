    "@wangeditor/core": "^1.1.19",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/list-module": "^1.0.5",
    "@wangeditor/table-module": "^1.1.4",
    "@wangeditor/upload-image-module": "^1.0.2",
    "@wangeditor/video-module": "^1.1.4",
    "axios": "^1.20.0",
    "pinia": "^3.0.4",
    "vant": "^4.10.2",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "happy-dom": "^21.0.3",
    "typescript": "^5.9.3",
